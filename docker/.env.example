# Docker Compose 部署变量示例
COMPOSE_PROJECT_NAME=lumen-local
TZ=Asia/Shanghai

# 仓库根路径。Provisioner / Sandbox 需要访问宿主机 runtimes 目录时会用到；
# 仓库不在 /root/Lumen 时必须改成真实绝对路径。
LUMEN_ROOT_DIR=/root/Lumen

# 持久化数据目录
POSTGRES_DATA_DIR=/root/data/postgres
ELASTICSEARCH_DATA_DIR=/root/data/es
REDIS_DATA_DIR=/root/data/redis
MINIO_DATA_DIR=/root/data/minio
RUNTIME_STATE_DIR=/root/Lumen/runtimes/state
RUNTIME_LOG_DIR=/root/data/logs
RAG_TASK_STATE_DIR=/root/data/lumen-rag

# 公开端口
LUMEN_HTTP_BIND_HOST=0.0.0.0
LUMEN_HTTP_PORT=80
LUMEN_HTTPS_BIND_HOST=0.0.0.0
LUMEN_HTTPS_PORT=443
# 默认仅用 HTTP 提供 ACME challenge，其余请求返回 308 到 HTTPS。
# serve 仅额外开放 HTTP 内容；443 server 仍要求有效证书。其他值会 fail closed。
LUMEN_HTTP_MODE=redirect

# 仅本机可访问的排障端口
LUMEN_LOCAL_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6378
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_HOST_PORT=13000
GATEWAY_HOST_PORT=8001
LANGGRAPH_HOST_PORT=2024
RAG_HOST_PORT=7791

# LangGraph 运行时当前仍包含同步 requests / subprocess / 文件 I/O 路径，
# 默认保留 --allow-blocking。等这些路径逐步异步化后再切回 false。
LUMEN_LANGGRAPH_ALLOW_BLOCKING=true

# 基础服务凭据
POSTGRES_DB=reader_qaq
POSTGRES_USER=reader
POSTGRES_PASSWORD=change-me
# Redis 两个独立密码必须至少 32 字符，且只能使用 A-Z、a-z、0-9、_、-。
# 推荐分别运行 `openssl rand -hex 32` 生成。
REDIS_PASSWORD=replace-with-a-strong-random-lumen-redis-password
RAG_REDIS_PASSWORD=replace-with-an-independent-random-rag-redis-password
MINIO_ROOT_USER=reader
MINIO_ROOT_PASSWORD=change-me
MINIO_DOMAIN=minio
MINIO_PROXY_HOST=minio:9000

# Backend、Gateway 与 LangGraph 之间共用的内部服务认证 token。
# 使用 `openssl rand -hex 32` 生成，部署前必须替换且三方必须完全一致。
GATEWAY_INTERNAL_API_TOKEN=replace-with-a-strong-random-gateway-token

# Backend 与 RAG 之间共用的独立内部 token。Compose 显式注入两方，不再把
# backend/.env 的全部业务秘密暴露给文档解析容器。
RAG_INTERNAL_API_TOKEN=replace-with-a-strong-random-rag-token

# Runtime 用它解析用户模型绑定；接口会返回解密后的 provider 配置，因此必须使用
# 独立于 RAG/Gateway 的随机 token。
MODEL_RESOLVER_INTERNAL_TOKEN=replace-with-a-strong-random-model-resolver-token

# Backend 保存模型绑定与 Runtime 实际发起请求时必须使用同一出站策略。
# 默认只允许公网端点；确需访问自托管私网 provider 时由运维显式开启。
MODEL_PROVIDER_ALLOW_PRIVATE_ENDPOINTS=false
MODEL_PROVIDER_DNS_TIMEOUT_SECONDS=5.0

# LangGraph 仅通过最小权限 Sandbox Provisioner 管理容器。该 token 与 Gateway
# token 必须独立，至少 32 个可打印 ASCII 字符；使用 `openssl rand -hex 32`。
SANDBOX_PROVISIONER_INTERNAL_TOKEN=replace-with-a-strong-random-sandbox-provisioner-token

# RAG worker 的最小 provider secret allowlist。按需与 backend/.env 中的
# embedding/CV 配置保持一致；RAG 不再继承业务数据库、JWT、SMTP 等凭据。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
CV_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CV_API_KEY=
ES_USERNAME=
ES_PASSWORD=

# RAG 访问 embedding、rerank、CV 等 provider 的统一 HTTP 边界。
# 代码还会强制连接不超过 60 秒、读取不超过 600 秒、响应不超过 256 MiB。
RAG_PROVIDER_CONNECT_TIMEOUT_SECONDS=10
RAG_PROVIDER_READ_TIMEOUT_SECONDS=120
RAG_PROVIDER_MAX_RESPONSE_BYTES=16777216

# 可选的沙箱供给参数。控制面不会接受调用方提交镜像、挂载、命令或权限选项。
SANDBOX_PROVISIONER_BASE_PORT=18080
SANDBOX_PROVISIONER_PIDS_LIMIT=512
# 必须使用不可变的 `name@sha256:<64 hex>` 引用；mutable tag 会使 provisioner 启动失败。
# SANDBOX_IMAGE=registry.example/lumen-sandbox@sha256:<64-lowercase-hex>

# RAG durable lease timing；heartbeat 必须小于 visibility timeout。
RAG_TASK_VISIBILITY_TIMEOUT_SECONDS=120
RAG_TASK_HEARTBEAT_INTERVAL_SECONDS=30
RAG_TASK_STALE_RECOVERY_INTERVAL_SECONDS=15

# 后端与 runtime 会复用 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 作为 MinIO 凭据

# Nginx 域名与证书
LUMEN_SERVER_NAME=ireader.online www.ireader.online
LUMEN_TLS_CERTS_DIR=/etc/letsencrypt
LUMEN_CERTBOT_WEBROOT_DIR=/var/www/certbot
LUMEN_SSL_CERT_PATH=/etc/letsencrypt/live/ireader.online/fullchain.pem
LUMEN_SSL_CERT_KEY_PATH=/etc/letsencrypt/live/ireader.online/privkey.pem

# 可选：镜像覆盖
# POSTGRES_IMAGE=
# ELASTICSEARCH_IMAGE=
# REDIS_IMAGE=
# MINIO_IMAGE=
# BACKEND_IMAGE=
# RUNTIME_IMAGE=
# Runtime 镜像内预构建 Python 环境；自定义镜像使用其他路径时一并覆盖。
# RUNTIME_VENV_SEED_PATH=/opt/insight-flow-venv
# RAG_IMAGE=
# NGINX_IMAGE=

# Docker Compose 部署变量示例
COMPOSE_PROJECT_NAME=lumen-local
TZ=Asia/Shanghai

# 仓库根路径。Provisioner / Sandbox 需要访问宿主机 runtimes 目录时会用到。
LUMEN_ROOT_DIR=/root/Lumen

# 持久化数据目录
POSTGRES_DATA_DIR=/root/data/postgres
ELASTICSEARCH_DATA_DIR=/root/data/es
REDIS_DATA_DIR=/root/data/redis
MINIO_DATA_DIR=/root/data/minio
RUNTIME_STATE_DIR=/root/Lumen/runtimes/state
RUNTIME_LOG_DIR=/root/data/logs

# 公开端口
LUMEN_HTTP_BIND_HOST=0.0.0.0
LUMEN_HTTP_PORT=80
LUMEN_HTTPS_BIND_HOST=0.0.0.0
LUMEN_HTTPS_PORT=443

# 仅本机可访问的排障端口
LUMEN_LOCAL_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6378
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_HOST_PORT=13000
GATEWAY_HOST_PORT=8001
LANGGRAPH_HOST_PORT=2024
RAG_HOST_PORT=7791

# LangGraph 运行时当前仍包含同步 requests / subprocess / 文件 I/O 路径，
# 默认保留 --allow-blocking。等这些路径逐步异步化后再切回 false。
LUMEN_LANGGRAPH_ALLOW_BLOCKING=true

# 基础服务凭据
POSTGRES_DB=reader_qaq
POSTGRES_USER=reader
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=reader
MINIO_ROOT_PASSWORD=change-me
MINIO_DOMAIN=minio
MINIO_PROXY_HOST=minio:9000

# 后端与 runtime 会复用 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 作为 MinIO 凭据

# Nginx 域名与证书
LUMEN_SERVER_NAME=ireader.online www.ireader.online
LUMEN_TLS_CERTS_DIR=/etc/letsencrypt
LUMEN_CERTBOT_WEBROOT_DIR=/var/www/certbot
LUMEN_SSL_CERT_PATH=/etc/letsencrypt/live/ireader.online/fullchain.pem
LUMEN_SSL_CERT_KEY_PATH=/etc/letsencrypt/live/ireader.online/privkey.pem

# 可选：镜像覆盖
# POSTGRES_IMAGE=
# ELASTICSEARCH_IMAGE=
# REDIS_IMAGE=
# MINIO_IMAGE=
# BACKEND_IMAGE=
# RUNTIME_IMAGE=
# RAG_IMAGE=
# NGINX_IMAGE=

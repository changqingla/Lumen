# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
INFOQUEST_API_KEY=your-infoquest-api-key

# Runtime checkpointer defaults. Local development uses the local Postgres service.
LUMEN_CHECKPOINTER_TYPE=postgres
LUMEN_CHECKPOINTER_CONNECTION_STRING=postgresql://reader:change-me@127.0.0.1:5433/reader_qaq

# Required when runs are admitted through the Lumen API quota boundary.
LUMEN_USAGE_REPORT_URL=http://127.0.0.1:13000/api/chat-runtime/internal/token-usage/events
LUMEN_USAGE_REPORT_TIMEOUT_SECONDS=5
LUMEN_USAGE_REPORT_RETRY_ATTEMPTS=4

# Gateway / Backend 内部 API 服务认证。使用 `openssl rand -hex 32` 生成；
# 非 Compose 本地开发时，必须与 backend/.env 中的同名变量完全一致。
GATEWAY_INTERNAL_API_TOKEN=replace-with-a-strong-random-gateway-token

# Runtime -> Backend dynamic model resolver authentication. Keep this separate
# from the Gateway, RAG, and Sandbox Provisioner tokens.
MODEL_RESOLVER_INTERNAL_TOKEN=replace-with-a-strong-random-model-resolver-token

# Standalone Runtime model endpoint policy. Compose deployments override these
# from docker/.env so Backend validation and the actual Runtime connection agree.
MODEL_PROVIDER_ALLOW_PRIVATE_ENDPOINTS=False
MODEL_PROVIDER_DNS_TIMEOUT_SECONDS=5.0

# AIO Sandbox Provisioner 内部认证。非 Compose provisioner 模式下，客户端与
# provisioner 必须使用同一个独立随机值；不能复用 Gateway token。
SANDBOX_PROVISIONER_INTERNAL_TOKEN=replace-with-a-strong-random-sandbox-provisioner-token
# SANDBOX_PROVISIONER_URL=http://127.0.0.1:8002

# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000

# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# =====================================
# Lumen API 配置模板
# 复制此文件为 .env 并填入真实值
# =====================================

# ============================================================================
# 应用基础配置
# ============================================================================
APP_NAME=Lumen API
APP_VERSION=1.0.0
DEBUG=False
API_PREFIX=/api

# CORS 域名白名单（JSON 数组格式）
# 正式部署不要使用 *，仅保留实际访问域名。
CORS_ORIGINS=["https://lumen.example.com","http://localhost","http://127.0.0.1"]

# ============================================================================
# 数据库配置
# ============================================================================
DATABASE_URL=postgresql+asyncpg://reader:change-me@lumen_postgres:5432/reader_qaq
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================================
# Redis 配置
# ============================================================================
REDIS_URL=redis://lumen:change-me@redis:6378/2

# ============================================================================
# MinIO/S3 对象存储配置
# ============================================================================
MINIO_ENDPOINT=minio:9000
# Must match docker MINIO_PROXY_HOST when MINIO_PUBLIC_ENDPOINT=nginx, otherwise
# S3 presigned signatures may not validate through the /minio proxy.
MINIO_PUBLIC_ENDPOINT=nginx
MINIO_ACCESS_KEY=reader
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=reader-uploads
MINIO_SECURE=False

# ============================================================================
# JWT 认证配置
# ============================================================================
SECRET_KEY=change-me-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 用户模型配置专用加密密钥。建议与 SECRET_KEY 分离，避免后续轮换互相影响。
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-dedicated-random-string
MODEL_CONFIG_TOKEN_EXPIRE_SECONDS=21600

# ============================================================================
# 上传限制配置
# ============================================================================
MAX_UPLOAD_SIZE=104857600
MAX_AVATAR_SIZE=10485760

# ============================================================================
# MinerU 文档解析服务配置
# ============================================================================
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your-mineru-api-token
MINERU_MODEL_VERSION=vlm

# ============================================================================
# 文档处理 / 运行时配置
# ============================================================================
DOC_PROCESS_BASE_URL=http://rag:7791/api
RAG_INTERNAL_API_TOKEN=replace-with-a-strong-random-token
INSIGHT_GATEWAY_URL=http://lumen_gateway:8001
INSIGHT_LANGGRAPH_URL=http://lumen_langgraph:2024
INSIGHT_GATEWAY_PUBLIC_BASE_URL=
INSIGHT_LANGGRAPH_PUBLIC_BASE_URL=
INSIGHT_ASSISTANT_ID=lead_agent
INSIGHT_ON_DISCONNECT=continue
INSIGHT_RECURSION_LIMIT=300
INSIGHT_REQUEST_TIMEOUT_SECONDS=120

# ============================================================================
# Elasticsearch 配置
# ============================================================================
ES_HOST=http://elasticsearch:9200

# ============================================================================
# Embedding 模型配置
# ============================================================================
EMBEDDING_MODEL_FACTORY=Tongyi-Qianwen
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-embedding-api-key

# ============================================================================
# Rerank 模型配置
# ============================================================================
RERANK_FACTORY=Tongyi-Qianwen
RERANK_MODEL_NAME=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=your-rerank-api-key

# ============================================================================
# 文档处理配置
# ============================================================================
DEFAULT_CHUNK_TOKEN_NUM=512
DEFAULT_PARSER_TYPE=general

# ============================================================================
# 搜索配置
# ============================================================================
SIMILARITY_THRESHOLD=0.01
VECTOR_SIMILARITY_WEIGHT=0.3

# ============================================================================
# 邮件服务配置
# ============================================================================
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USERNAME=no-reply@lumen.example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Lumen
SMTP_TIMEOUT=10

# ============================================================================
# HTTP 客户端超时配置（秒）
# ============================================================================
HTTP_DEFAULT_TIMEOUT=60.0
HTTP_UPLOAD_TIMEOUT=300.0
HTTP_DOWNLOAD_TIMEOUT=120.0

# ============================================================================
# 创意工坊配置
# ============================================================================
# OpenAI 兼容图片生成服务，示例：https://api.openai.com/v1 或自建代理 https://example.com/v1
CREATIVE_WORKSHOP_IMAGE_BASE_URL=https://api.openai.com/v1
CREATIVE_WORKSHOP_IMAGE_API_KEY=your-image-api-key
CREATIVE_WORKSHOP_IMAGE_MODEL=gpt-image-2
CREATIVE_WORKSHOP_IMAGE_TIMEOUT=180.0

# ============================================================================
# 安全配置
# ============================================================================
MAX_PASSWORD_LENGTH=72

# ============================================================================
# 用户默认配置
# ============================================================================
DEFAULT_USER_FOLDERS=["学习","工作","生活"]
DEFAULT_KB_NAME=我的知识库
DEFAULT_KB_DESCRIPTION=这是您的第一个知识库，您可以在这里上传和管理文档
DEFAULT_KB_CATEGORY=其它

# =====================================
# Lumen API 配置模板
# 复制此文件为 .env 并填入真实值
# =====================================

# ============================================================================
# 应用基础配置
# ============================================================================
APP_NAME=Lumen API
APP_VERSION=1.0.0
DEBUG=False
API_PREFIX=/api

# CORS 域名白名单（JSON 数组格式）
# 正式部署不要使用 *，仅保留实际访问域名。
CORS_ORIGINS=["https://lumen.example.com","http://localhost","http://127.0.0.1"]

# ============================================================================
# 数据库配置
# ============================================================================
DATABASE_URL=postgresql+asyncpg://reader:change-me@lumen_postgres:5432/reader_qaq
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# run_migrations.py 等待全局 PostgreSQL session advisory lock 的最长时间。
MIGRATION_LOCK_TIMEOUT_SECONDS=60
# 生产环境必须使用 PostgreSQL advisory lock；process 仅允许 DEBUG=True 的单机开发。
THREAD_MATERIALIZATION_LOCK_BACKEND=postgresql
THREAD_MATERIALIZATION_LOCK_TIMEOUT_SECONDS=30
THREAD_MATERIALIZATION_LOCK_POLL_INTERVAL_SECONDS=0.1

# ============================================================================
# Redis 配置
# ============================================================================
REDIS_URL=redis://lumen:change-me@redis:6378/2

# ============================================================================
# MinIO/S3 对象存储配置
# ============================================================================
MINIO_ENDPOINT=minio:9000
# Must match docker MINIO_PROXY_HOST when MINIO_PUBLIC_ENDPOINT=nginx, otherwise
# S3 presigned signatures may not validate through the /minio proxy.
MINIO_PUBLIC_ENDPOINT=nginx
MINIO_ACCESS_KEY=reader
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=reader-uploads
MINIO_SECURE=False

# ============================================================================
# JWT 认证配置
# ============================================================================
SECRET_KEY=change-me-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GUEST_TOKEN_EXPIRE_DAYS=30

# 用户模型配置专用加密密钥。建议与 SECRET_KEY 分离，避免后续轮换互相影响。
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-dedicated-random-string
MODEL_CONFIG_TOKEN_EXPIRE_SECONDS=21600
# 默认仅允许解析到公网地址的用户自定义模型 Base URL。
# 仅本地开发时可显式设为 True，生产环境必须保持 False。
MODEL_PROVIDER_ALLOW_PRIVATE_ENDPOINTS=False
MODEL_PROVIDER_DNS_TIMEOUT_SECONDS=5.0

# ============================================================================
# 上传限制配置
# ============================================================================
MAX_UPLOAD_SIZE=104857600
MAX_AVATAR_SIZE=10485760

# ============================================================================
# MinerU 文档解析服务配置
# ============================================================================
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your-mineru-api-token
MINERU_MODEL_VERSION=vlm
# MinerU API 与其返回的签名 URL 仅允许 HTTPS、公网 DNS，连接前会再次校验并固定 IP。
MINERU_DNS_TIMEOUT_SECONDS=5.0
# ZIP 下载与解压硬上限；按部署可用内存和预期文档规模谨慎调整。
MINERU_MAX_ZIP_DOWNLOAD_BYTES=134217728
MINERU_MAX_ZIP_MEMBER_COUNT=2048
MINERU_MAX_ZIP_MEMBER_UNCOMPRESSED_BYTES=67108864
MINERU_MAX_ZIP_TOTAL_UNCOMPRESSED_BYTES=268435456

# ============================================================================
# 文档处理 / 运行时配置
# ============================================================================
DOC_PROCESS_BASE_URL=http://rag:7791/api
RAG_INTERNAL_API_TOKEN=replace-with-a-strong-random-token
INSIGHT_GATEWAY_URL=http://lumen_gateway:8001
INSIGHT_LANGGRAPH_URL=http://lumen_langgraph:2024
# 非 Compose 本地开发时，必须与 Runtime 的同名变量完全一致。
GATEWAY_INTERNAL_API_TOKEN=replace-with-a-strong-random-gateway-token
# Runtime 解析用户模型绑定的独立 token；不得复用 RAG 或 Gateway token。
MODEL_RESOLVER_INTERNAL_TOKEN=replace-with-a-strong-random-model-resolver-token
INSIGHT_ASSISTANT_ID=lead_agent
INSIGHT_ON_DISCONNECT=continue
INSIGHT_RECURSION_LIMIT=300
INSIGHT_REQUEST_TIMEOUT_SECONDS=120

# 每个 Run 在启动前原子预留的 token；未消费部分在 Runtime 完成事件后释放。
TOKEN_QUOTA_RUN_RESERVATION_TOKENS=250000
# 崩溃或取消但未收到完成事件时，预留最多保留 6 小时后自动回收。
TOKEN_QUOTA_RESERVATION_TTL_SECONDS=21600
TOKEN_USAGE_STREAM_CLAIM_IDLE_SECONDS=30
TOKEN_USAGE_STREAM_BLOCK_MILLISECONDS=2000

# ============================================================================
# Elasticsearch 配置
# ============================================================================
ES_HOST=http://elasticsearch:9200
# Elasticsearch 启用认证时填写；业务后端与 RAG Worker 共用这组连接凭据。
ES_USERNAME=
ES_PASSWORD=

# ============================================================================
# Embedding 模型配置
# ============================================================================
EMBEDDING_MODEL_FACTORY=Tongyi-Qianwen
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-embedding-api-key

# ============================================================================
# RAG 视觉解析模型配置
# ============================================================================
# 仅使用 general 等纯文本 parser 时可留空；视觉 parser 在 Worker 启动时读取，
# 凭据不会写入 Redis 任务 metadata。
CV_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CV_API_KEY=your-visual-parser-api-key

# ============================================================================
# 文档处理配置
# ============================================================================
DEFAULT_CHUNK_TOKEN_NUM=512
DEFAULT_PARSER_TYPE=general
KNOWLEDGE_DOCUMENT_WORKER_CONCURRENCY=1
KNOWLEDGE_DOCUMENT_QUEUE_VISIBILITY_TIMEOUT_SECONDS=120
KNOWLEDGE_DOCUMENT_QUEUE_HEARTBEAT_INTERVAL_SECONDS=10
KNOWLEDGE_DOCUMENT_QUEUE_MAX_RETRIES=2
KNOWLEDGE_DOCUMENT_QUEUE_RETRY_DELAY_SECONDS=5
KNOWLEDGE_DOCUMENT_QUEUE_RECONCILE_INTERVAL_SECONDS=30
KNOWLEDGE_DOCUMENT_QUEUE_RECONCILE_BATCH_SIZE=100
KNOWLEDGE_DOCUMENT_QUEUE_RECONCILE_MAX_DOCUMENTS=1000
KNOWLEDGE_DOCUMENT_QUEUE_CANCEL_WAIT_SECONDS=15
KNOWLEDGE_DOCUMENT_RAG_CANCEL_WAIT_SECONDS=15

# ============================================================================
# 邮件服务配置
# ============================================================================
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USERNAME=no-reply@lumen.example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Lumen
SMTP_TIMEOUT=10

# ============================================================================
# HTTP 客户端超时配置（秒）
# ============================================================================
HTTP_DEFAULT_TIMEOUT=60.0
HTTP_UPLOAD_TIMEOUT=300.0
HTTP_DOWNLOAD_TIMEOUT=120.0

# ============================================================================
# 创意工坊配置
# ============================================================================
# OpenAI 兼容图片生成服务，示例：https://api.openai.com/v1 或自建代理 https://example.com/v1
CREATIVE_WORKSHOP_IMAGE_BASE_URL=https://api.openai.com/v1
CREATIVE_WORKSHOP_IMAGE_API_KEY=your-image-api-key
CREATIVE_WORKSHOP_IMAGE_MODEL=gpt-image-2
CREATIVE_WORKSHOP_IMAGE_TIMEOUT=180.0
# 图片 provider JSON（含 base64 图片）解码后的最大响应字节数。
CREATIVE_WORKSHOP_IMAGE_MAX_RESPONSE_BYTES=52428800
# 论文翻译的 manifest、源 PDF 与 fenced worker 产物根目录。
CREATIVE_WORKSHOP_PAPER_TRANSLATION_STORAGE_DIR=logs/creative-workshop/paper-translation
CREATIVE_WORKSHOP_PAPER_TRANSLATION_MINERU_POLL_INTERVAL_SECONDS=5.0
CREATIVE_WORKSHOP_PAPER_TRANSLATION_MINERU_MAX_ATTEMPTS=180
CREATIVE_WORKSHOP_PAPER_TRANSLATION_AGENT_TIMEOUT_SECONDS=1800.0
CREATIVE_WORKSHOP_PAPER_TRANSLATION_AGENT_RECURSION_LIMIT=300
CREATIVE_WORKSHOP_PAPER_TRANSLATION_AGENT_MAX_CONTINUATIONS=2
CREATIVE_WORKSHOP_PAPER_TRANSLATION_WORKER_CONCURRENCY=1
# heartbeat 必须显著短于 visibility timeout；过期 lease 会被 maintenance 回收。
CREATIVE_WORKSHOP_PAPER_TRANSLATION_QUEUE_VISIBILITY_TIMEOUT_SECONDS=120.0
CREATIVE_WORKSHOP_PAPER_TRANSLATION_QUEUE_HEARTBEAT_INTERVAL_SECONDS=10.0
CREATIVE_WORKSHOP_PAPER_TRANSLATION_QUEUE_MAX_RETRIES=0
CREATIVE_WORKSHOP_PAPER_TRANSLATION_QUEUE_RETRY_DELAY_SECONDS=5.0
CREATIVE_WORKSHOP_PAPER_TRANSLATION_QUEUE_RECONCILE_INTERVAL_SECONDS=30.0
CREATIVE_WORKSHOP_PAPER_TRANSLATION_QUEUE_MAINTENANCE_BATCH_SIZE=100
CREATIVE_WORKSHOP_PAPER_TRANSLATION_QUEUE_RECONCILE_MAX_TASKS=1000

# ============================================================================
# 审计日志配置
# ============================================================================
# 记录用户聊天、知识库和创意工坊事件；默认只保存 prompt 长度与不可逆指纹。
# 相对路径会写到仓库根目录；Docker 部署默认由 docker-compose 覆盖为 /audit-logs。
AUDIT_LOG_DIR=logs
AUDIT_LOG_INCLUDE_PROMPTS=false
AUDIT_LOG_RETENTION_DAYS=30

# ============================================================================
# 安全配置
# ============================================================================
MAX_PASSWORD_LENGTH=72
# 每个来源每天最多签发的全新游客身份数。已有有效凭证的复用不计数。
AUTH_RATE_LIMIT_GUEST_SESSION_WINDOW_SECONDS=86400
AUTH_RATE_LIMIT_GUEST_SESSION_MAX=10

# ============================================================================
# 用户默认配置
# ============================================================================
DEFAULT_USER_FOLDERS=["学习","工作","生活"]
DEFAULT_KB_NAME=我的知识库
DEFAULT_KB_DESCRIPTION=这是您的第一个知识库，您可以在这里上传和管理文档
DEFAULT_KB_CATEGORY=其它
